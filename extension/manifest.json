{
  "manifest_version": 3,
  "name": "TrustLens",
  "version": "0.2.0",
  "description": "Ask your trusted YouTube & Instagram creators. Every answer is cross-checked with a Legitimacy Report.",
  "permissions": ["sidePanel", "storage", "alarms"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "TrustLens — Cross-Checked Answers" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
