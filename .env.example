# ──────────────────────────────────────────────
# TrustLens – Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
#   cp .env.example .env

# LLM (OpenAI-compatible; Nebius AI Studio hosting NVIDIA Nemotron)
# Get your key at: https://studio.nebius.com
LLM_BASE_URL=https://api.studio.nebius.com/v1/
LLM_API_KEY=your-nebius-key
LLM_MODEL=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1
EMBED_MODEL=BAAI/bge-en-icl

# Alternative newer Nebius models (uncomment to switch):
# LLM_MODEL=nebius/nvidia/nemotron-3-super-120b-a12b
# EMBED_MODEL=nebius/Qwen/Qwen3-Embedding-8B

# Optional: Hermes agent in NemoClaw/OpenShell sandbox (OpenAI-compatible).
# Leave empty to call the LLM directly.
AGENT_URL=
AGENT_API_KEY=

# Web search for evidence gathering: tavily | brave
# Get a Tavily key at: https://tavily.com  |  Brave at: https://api.search.brave.com
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your-search-key

# Local storage path (relative to backend/ directory)
DB_PATH=trustlens.db
