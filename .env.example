# LLM (OpenAI-compatible; default shown is Nebius serverless hosting an NVIDIA Nemotron model)
LLM_BASE_URL=https://api.studio.nebius.com/v1/
LLM_API_KEY=your-nebius-key
LLM_MODEL=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1
EMBED_MODEL=BAAI/bge-en-icl

# Optional: Hermes agent in NemoClaw/OpenShell sandbox (OpenAI-compatible). Leave empty to call the LLM directly.
AGENT_URL=
AGENT_API_KEY=

# Web search: tavily | brave
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your-search-key

# Local storage
DB_PATH=trustlens.db
